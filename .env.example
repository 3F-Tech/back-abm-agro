# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/database_name"

# JWT Secret for Application Tokens
JWT_SECRET="your-super-secret-jwt-key-here"

# SSO Configuration - Hub 3F Public Key
# Format: Must be in PEM format (PKCS#8)
# Obtain this key from the Hub 3F team
# Example format (multi-line string):
SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
(your actual public key here)
...
-----END PUBLIC KEY-----"

# Note: In production, ensure this key matches the private key used by Hub 3F
# The key should be kept secure and only the public portion is stored here
