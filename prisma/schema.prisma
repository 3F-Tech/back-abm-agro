  bairro                      String?
  cep                         String?
  uf                          String?
  municipio                   String?
  ddd1                        String?
  telefone1                   String?
  ddd2                        String?
  telefone2                   String?
  ddd_fax                     String?
  fax                         String?
  correio_eletronico          String?
  situacao_especial           String?
  data_situacao_especial      String?
  lat                         Float?
  long                        Float?
  situation                   String?
  classification              String?
