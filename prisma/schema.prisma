model motivos {
  codigo_motivo    String @id
  descricao_motivo String

  @@schema("cnpj")
}

model naturezas_juridicas {
  codigo_natureza_juridica    String    @id
  descricao_natureza_juridica String
  empresas                    Empresa[]

  @@schema("cnpj")
}

model paises {
  codigo_pais    String @id
  descricao_pais String

  @@schema("cnpj")
}

model qualificacoes {
  codigo_qualificacao    String  @id
  descricao_qualificacao String
  socios                 Socio[]

  @@schema("cnpj")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model simples {
  cnpj_basico           String   @id
  opcao_simples         String?
  data_opcao_simples    String?
  data_exclusao_simples String?
  opcao_mei             String?
  data_opcao_mei        String?
  data_exclusao_mei     String?
  empresas              Empresa? @relation(fields: [cnpj_basico], references: [cnpj_basico], onDelete: NoAction, onUpdate: NoAction, map: "fk_simples_empresa")

  @@index([cnpj_basico], map: "idx_simples_cnpj_basico")
  @@map("simples")
  @@schema("cnpj")
}

model user {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique(map: "uq_user_email") @db.VarChar(100)
  password   String   @db.VarChar(255)
  role       Role     @default(COMUM)
  created_at DateTime @default(now()) @map("created-at")
  updated_at DateTime @default(now()) @map("updated-at")

  @@schema("cnpj")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model empresas_stg {
  cnpj String?
  nome String?
  uf   String?

  @@ignore
  @@schema("public")
}

enum Role {
  COMUM
  ADMIN

  @@schema("cnpj")
}
