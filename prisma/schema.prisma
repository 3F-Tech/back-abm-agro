/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model fazendas_110k {
  a1_nome                String?
  a1_endcob              String?
  a1_bairroc             String?
  a1_munc                String?
  a1_estc                String?
  a1_cepc                String?
  a1_cgc                 String?
  a1_ddd                 String?
  a1_tel                 String?
  a1_celular             String?
  endereco_entrega       String?
  bairro_entrega         String?
  municipio_entrega      String?
  estado_entrega         String?
  cep_entrega            String?
  a1_tel3                String?
  a1_tel4                String?
  a1_tel5                String?
